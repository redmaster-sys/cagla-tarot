{
  "name": "cagla-tarot",
  "private": true,
  "version": "1.0.0",
  "description": "Çağla Tarot — Dijital Tarot Masası: 78 Kartlık Rider–Waite–Smith Destesi ve Google Gemini Yapay Zekâ Yorumlama Uygulaması",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
