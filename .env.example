# ==============================================================================
# ÇAĞLA TAROT — İSTEMCİ (FRONTEND) ORTAM DEĞİŞKENLERİ ÖRNEĞİ (.env.example)
# ==============================================================================
# ÖNEMLİ GÜVENLİK UYARISI:
# GEMINI_API_KEY ve TURNSTILE_SECRET_KEY gizli anahtarlarını ASLA bu dosyaya,
# Vite istemci değişkenlerine (VITE_*) veya GitHub deposuna eklemeyin!
# Bu gizli anahtarlar yalnızca Cloudflare Worker ortamında `wrangler secret put`
# komutuyla tanımlanmalıdır:
#   cd worker
#   npx wrangler secret put GEMINI_API_KEY
#   npx wrangler secret put TURNSTILE_SECRET_KEY
# ==============================================================================

# Cloudflare Worker API uç noktası (Geliştirmede Vite proxy veya yerel worker, üretimde workers.dev URL'si)
VITE_WORKER_API_URL=https://cagla-tarot-worker.<cloudflare-alt-alan-adiniz>.workers.dev/api/interpret

# Cloudflare Turnstile herkese açık Site Key (Üretimde Cloudflare panelinden alınan Site Key; geliştirmede test anahtarı)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# GitHub Pages alt dizin yolu (cagla-tarot deposu için /cagla-tarot/ veya göreceli ./)
VITE_BASE_PATH=./
